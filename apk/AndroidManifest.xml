<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.letsgorecomp"
    android:versionCode="1793115500"
    android:versionName="0.1.0-boot">

    <!-- Vulkan 1.3 is required by the NVN-on-Vulkan renderer -->
    <uses-feature android:name="android.hardware.vulkan.version" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="4194307" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <!-- Downloading the GPU driver package recommended for this phone (GitHub releases, on the player's request) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Full filesystem access: the game reads exefs/romfs via direct fopen() -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="29" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="Let's Go Recomp"
                 android:icon="@drawable/icon"
                 android:allowBackup="true"
                 android:extractNativeLibs="true"
                 android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
                 android:hardwareAccelerated="true">
        <!-- The launcher and the log follow the phone (fold, unfold, rotation; the system's rotation lock is
             respected); only the game (LetsGoActivity) stays in landscape. configChanges keeps their screen alive. -->
        <activity android:name="com.letsgorecomp.LetsGoLauncherActivity"
                  android:theme="@style/Launcher"
                  android:label="Let's Go Recomp"
                  android:screenOrientation="unspecified"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.letsgorecomp.LogActivity"
                  android:label="Log"
                  android:screenOrientation="unspecified"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
                  android:exported="false" />
        <activity android:name="com.letsgorecomp.LetsGoActivity"
                  android:label="Let's Go Recomp"
                  android:theme="@style/Fullscreen"
                  android:alwaysRetainTaskState="true"
                  android:launchMode="singleTask"
                  android:screenOrientation="landscape"
                  android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
                  android:exported="false" />
        <activity android:name=".GameBuild" android:exported="false" />
        <service android:name=".GameBuildService" android:exported="false" android:foregroundServiceType="specialUse" android:process=":builder">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local compilation of the user's extracted game; resumable, user initiated" />
        </service>
    </application>
</manifest>
